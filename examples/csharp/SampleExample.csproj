<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>SampleExample</AssemblyName>
    <RootNamespace>SampleExample</RootNamespace>
    <TargetFramework>net48</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PyfOutputDir Condition="'$(PyfOutputDir)' == ''">..\..\modules\sample\out\net48\release</PyfOutputDir>
    <PyfModuleName Condition="'$(PyfModuleName)' == ''">sample</PyfModuleName>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(PyfModuleName)">
      <HintPath>$(PyfOutputDir)\$(PyfModuleName).dll</HintPath>
    </Reference>
    <Content Include="$(PyfOutputDir)\*.dll"
             Exclude="$(PyfOutputDir)\$(PyfModuleName).dll;$(PyfOutputDir)\ModulePlatform.dll"
             Link="%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(PyfOutputDir)\*.py"
             Link="%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(PyfOutputDir)\$(PyfModuleName)_rpc.exe"
             Condition="Exists('$(PyfOutputDir)\$(PyfModuleName)_rpc.exe')"
             Link="$(PyfModuleName)_rpc.exe"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
